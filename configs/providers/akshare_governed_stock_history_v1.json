{
  "policy_id": "akshare-governed-stock-history-v1",
  "application_provider": "AKShare",
  "selection_scope": "complete_run",
  "primary": {
    "function": "stock_zh_a_hist",
    "upstream": "East Money",
    "endpoint_family": "push2his.eastmoney.com"
  },
  "secondary": {
    "function": "stock_zh_a_hist_tx",
    "upstream": "Tencent",
    "endpoint_family": "web.ifzq.gtimg.cn;proxy.finance.qq.com",
    "activation_mode": "explicit_approved_primary_failure_only"
  },
  "approved_primary_failure_classes": [
    "BROWSER_NET_EMPTY_RESPONSE",
    "CONNECTION_RESET",
    "HTTP_429_RATE_LIMITED",
    "HTTP_5XX_PROVIDER_ERROR"
  ],
  "attempts_per_symbol_per_batch": 1,
  "provider_timeout_seconds": 30,
  "max_batch_wall_clock_seconds": 1800,
  "min_seconds_between_symbol_calls": 0.2,
  "required_coverage_ratio": 1.0,
  "adjustment_policy": "qfq",
  "cross_source_contract_version": "eastmoney-tencent-qfq-production-v2",
  "cross_source_tolerances": {
    "ohlc_absolute_cny": 0.01,
    "ohlc_relative": 0.0005,
    "volume_absolute_provider_units": 0.0,
    "diagnostic_monetary_amount_absolute_cny": 100.0,
    "diagnostic_monetary_amount_relative": 0.000001
  },
  "tencent_semantics": {
    "akshare_exported_amount_field": "volume",
    "volume_canonical_scale": 1.0,
    "volume_unit": "hand",
    "monetary_amount": "unavailable_from_stock_zh_a_hist_tx",
    "missing_monetary_amount_fill_allowed": false
  },
  "operational_field_contract": {
    "version": "tencent-nullable-amount-operational-v1",
    "required_fields": [
      "trade_date",
      "symbol",
      "open",
      "high",
      "low",
      "close",
      "volume"
    ],
    "nullable_fields": [
      "amount",
      "turnover_rate"
    ],
    "amount_required_by_daily_refresh": false,
    "null_amount_quality_flag": "TENCENT_AMOUNT_UNAVAILABLE",
    "null_is_distinct_from_observed_zero": true,
    "fail_closed_when_consumer_requires_amount": true
  },
  "non_production_adjustments": {
    "unadjusted_runtime_enabled": false,
    "unadjusted_fixture_audit_enabled": true,
    "hfq_runtime_enabled": false,
    "hfq_research_audit_enabled": true,
    "hfq_findings_block_qfq_production": false
  },
  "allow_per_symbol_source_mixing": false,
  "allow_silent_fallback": false,
  "tls_verification_required": true,
  "deterministic_replay_may_be_presented_as_live": false
}
